   "type": "minimax",
   "device": "default"
  }
 },
 "m_vae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "minimax_h3_video_vae_int8_convrot.safetensors"
  }
 },
 "i_cond": {
  "class_type": "MiniMaxH3ImageToVideo",
  "inputs": {
   "clip": [
    "m_clip",
    0
   ],
   "vae": [
    "m_vae",
    0
   ],
   "prompt": "{{PROMPT}}",
   "width": "{{WIDTH}}",
   "height": "{{HEIGHT}}",
   "length": "{{LENGTH}}",
   "first_frame": [
    "i_first",
    0
   ],
   "last_frame": [
    "i_last",
    0
   ]
  }
 },
 "i_first": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "{{FIRST_IMAGE}}"
  }
 },
 "i_last": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "{{LAST_IMAGE}}"
  }
 },
 "m_turbo": {
  "class_type": "LoraLoaderModelOnly",
  "inputs": {
   "model": [
    "m_unet",
    0
   ],
   "lora_name": "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors",
   "strength_model": 1.0
  }
 },
 "s_sampler": {
  "class_type": "KSamplerSelect",
  "inputs": {
   "sampler_name": "res_multistep"
  }
 },
 "s_sched": {
  "class_type": "BasicScheduler",
  "inputs": {
   "model": [
    "m_turbo",
    0
   ],
   "scheduler": "simple",
   "steps": "{{STEPS}}",
   "denoise": 1.0
  }
 },
 "s_noise": {
  "class_type": "RandomNoise",
  "inputs": {
   "noise_seed": "{{SEED}}"
  }
 },
 "s_guider": {
  "class_type": "BasicGuider",
  "inputs": {
   "model": [
    "m_turbo",
    0
   ],
   "conditioning": [
    "i_cond",
    0
   ]
  }
 },
 "s_run": {
  "class_type": "SamplerCustomAdvanced",
  "inputs": {
   "noise": [
    "s_noise",
    0
   ],
   "guider": [
    "s_guider",
    0
   ],
   "sampler": [
    "s_sampler",
    0
   ],
   "sigmas": [
    "s_sched",
    0
   ],
   "latent_image": [
    "i_cond",
    1
   ]
  }
 },
 "s_decode": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "s_run",
    0
   ],
   "vae": [
    "m_vae",
    0
   ]
  }
 },
 "s_save": {
  "class_type": "SaveImage",
  "inputs": {
   "images": [
    "s_decode",
    0
   ],
   "filename_prefix": "{{PREFIX}}"
  }
 }
}